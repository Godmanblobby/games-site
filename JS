* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #0f172a;
  color: #e2e8f0;
}

.site-header {
  padding: 20px;
  text-align: center;
  background: #111827;
  border-bottom: 1px solid #1f2937;
}

.site-header h1 {
  margin: 0 0 8px;
  font-size: 2rem;
}

.site-header p {
  margin: 0;
  color: #94a3b8;
}

.layout {
  display: grid;
  grid-template-columns: 280px 1fr;
  min-height: calc(100vh - 109px);
}

.sidebar {
  border-right: 1px solid #1f2937;
  background: #111827;
  padding: 16px;
}

#searchInput {
  width: 100%;
  padding: 10px 12px;
  margin-bottom: 16px;
  border: 1px solid #334155;
  border-radius: 8px;
  background: #0f172a;
  color: #e2e8f0;
}

.games-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.game-card {
  width: 100%;
  padding: 12px;
  text-align: left;
  border: 1px solid #334155;
  border-radius: 10px;
  background: #1e293b;
  color: #e2e8f0;
  cursor: pointer;
  transition: background 0.2s ease, transform 0.2s ease;
}

.game-card:hover {
  background: #334155;
  transform: translateY(-1px);
}

.game-card.active {
  border-color: #60a5fa;
  background: #1d4ed8;
}

.viewer {
  display: flex;
  flex-direction: column;
  padding: 16px;
  gap: 12px;
}

.viewer-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.viewer-topbar h2 {
  margin: 0;
  font-size: 1.2rem;
}

#fullscreenBtn {
  padding: 10px 14px;
  border: none;
  border-radius: 8px;
  background: #2563eb;
  color: white;
  cursor: pointer;
}

#fullscreenBtn:hover {
  background: #1d4ed8;
}

.iframe-wrap {
  flex: 1;
  min-height: 500px;
  border: 1px solid #1f2937;
  border-radius: 12px;
  overflow: hidden;
  background: #020617;
}

#gameFrame {
  width: 100%;
  height: 100%;
  min-height: 500px;
  border: 0;
  background: #000;
}

@media (max-width: 800px) {
  .layout {
    grid-template-columns: 1fr;
  }

  .sidebar {
    border-right: none;
    border-bottom: 1px solid #1f2937;
  }
}
